# ============================================================
# Chordix — ניתוב Cloudflare Pages
# ------------------------------------------------------------
# עד היום Cloudflare הגיש את index.html לכל כתובת (fallback של SPA),
# כך שגם כתובת שגויה כמו /build החזירה את דף הבית עם 200.
# עכשיו יש 404.html, ולכן כל כתובת שאינה קובץ אמיתי ואינה ברשימה כאן
# תחזיר "לא נמצא" (404). לכן חובה למפות כאן את כל הראוטים של צד-הלקוח
# → הם מוגשים כ-index.html עם 200, וה-router ב-JS מציג את העמוד הנכון.
#
# ⚠ ראוט חדש ב-index.html (CX_ROUTES / CX_LEGAL_ROUTES) חייב להתווסף כאן,
#   אחרת רענון/כניסה ישירה אליו יחזירו 404.
# מקורות-אמת: CX_ROUTES ו-CX_LEGAL_ROUTES ב-index.html, ו-sitemap.xml.
# תחביר: <from> <to> <status> (proxy/rewrite ב-200; Cloudflare Pages).
# ============================================================

# --- כלים למוזיקאי ועמודי-תוכן (CX_ROUTES) ---
/how            /index.html   200
/features       /index.html   200
/faq            /index.html   200
/library        /index.html   200
/tips           /index.html   200
/metronome      /index.html   200
/guitar-chords  /index.html   200
/piano-chords   /index.html   200
/tuner          /index.html   200
/capo           /index.html   200
/tools          /index.html   200

# --- מסמכים משפטיים (CX_LEGAL_ROUTES) ---
/terms          /index.html   200
/privacy        /index.html   200
/cookies        /index.html   200
/refunds        /index.html   200
/accessibility  /index.html   200
/licenses       /index.html   200

# --- דשבורד ניהול (קובץ אמיתי; מפורש ליתר ביטחון) ---
/admin          /admin.html   200
