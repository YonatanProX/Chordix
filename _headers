# ============================================================
# Netlify — כותרות מטמון ואבטחה
# ============================================================

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://cdn.jsdelivr.net; connect-src 'self' https://qksqaqpgmvrpxonpzgxc.supabase.co; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https:; font-src 'self' data: https:; media-src 'self' blob: data:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'; upgrade-insecure-requests
  Cross-Origin-Opener-Policy: same-origin

# ה-HTML משתנה בכל פרסום — תמיד לאמת מול השרת
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# המודל לא משתנה. שנה שלמה של מטמון, immutable.
# בעדכון מודל: לשנות את שם הקובץ (למשל chordix-model-v2.bin)
# ולעדכן את CX_MODEL_URL ב-index.html.
/chordix-model-e1.bin
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/octet-stream

/chordix-model.bin
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/octet-stream

/og-cover.png
  Cache-Control: public, max-age=604800

/site.webmanifest
  Cache-Control: public, max-age=86400
  Content-Type: application/manifest+json

/sw.js
  Cache-Control: public, max-age=0, must-revalidate

# Development/benchmark entrypoint must not be publicly served.
/bench.html
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store
  Content-Security-Policy: default-src 'none'

# Never publish source maps or hidden source-control metadata.
/*.map
  X-Robots-Tag: noindex, nofollow, noarchive

/.git/*
  X-Robots-Tag: noindex, nofollow, noarchive
