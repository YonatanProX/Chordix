# ============================================================
# Cloudflare Pages — כותרות מטמון ואבטחה
# script-src: ה-build (build/obfuscate.mjs) מחליף את 'unsafe-inline' ב-hashes של הסקריפטים
# המוטמעים שנשארים ב-dist/index.html. אין כאן לערוך hashes ידנית.
# ============================================================

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; connect-src 'self' https://qksqaqpgmvrpxonpzgxc.supabase.co; img-src 'self' data: blob: https://*.googleusercontent.com https://cdn.discordapp.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; media-src 'self' blob: data:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

# ה-HTML משתנה בכל פרסום — תמיד לאמת מול השרת
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# המודל לא משתנה. שנה שלמה של מטמון, immutable.
# בעדכון מודל: לשנות את שם הקובץ (למשל chordix-model-v2.bin)
# ולעדכן את CX_MODEL_URL ב-index.html.
/chordix-model-e1.bin
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/octet-stream

/chordix-model.bin
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/octet-stream

/og-cover.png
  Cache-Control: public, max-age=604800

/site.webmanifest
  Cache-Control: public, max-age=86400
  Content-Type: application/manifest+json

/sw.js
  Cache-Control: public, max-age=0, must-revalidate

# שם הקובץ כולל hash של התוכן — בטוח לשמור לשנה
/app.*.js
  Cache-Control: public, max-age=31536000, immutable

# Development/benchmark entrypoint must not be publicly served.
/bench.html
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store
  Content-Security-Policy: default-src 'none'

# Never publish source maps or hidden source-control metadata.
/*.map
  X-Robots-Tag: noindex, nofollow, noarchive

/.git/*
  X-Robots-Tag: noindex, nofollow, noarchive

# גופנים באירוח עצמי — לא משתנים
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
