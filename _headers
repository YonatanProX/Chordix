# ============================================================
# Netlify — כותרות מטמון ואבטחה
# ============================================================

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

# ה-HTML משתנה בכל פרסום — תמיד לאמת מול השרת
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# המודל לא משתנה. שנה שלמה של מטמון, immutable.
# בעדכון מודל: לשנות את שם הקובץ (למשל chordix-model-v2.bin)
# ולעדכן את CX_MODEL_URL ב-index.html.
/chordix-model.bin
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/octet-stream

/og-cover.png
  Cache-Control: public, max-age=604800

/site.webmanifest
  Cache-Control: public, max-age=86400
  Content-Type: application/manifest+json

/sw.js
  Cache-Control: public, max-age=0, must-revalidate
